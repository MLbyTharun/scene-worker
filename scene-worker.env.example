SCENE_WORKER_PORT=8090
SCENE_WORKER_API_TOKEN=change-me
SCENE_WORKER_MAX_PROCESSES=1
SCENE_WORKER_STOP_TIMEOUT_SECONDS=10
SCENE_WORKER_LOG_LINES=200

# ---- OpenAI-compatible vision model API (no local Qwen weights) ----
# vLLM/Ollama/OpenRouter/DeepInfra-style base URL, usually ending in /v1
VLM_BASE_URL=http://host.docker.internal:8000/v1
VLM_API_KEY=
# Model id exactly as your API server lists it. Models come from the API.
VLM_MODEL=
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=500
VLM_TEMPERATURE=0.1
VLM_JSON_MODE=true
VLM_IMAGE_DETAIL=auto
VLM_MAX_IMAGE_SIDE=768
VLM_JPEG_QUALITY=80
VLM_EXTRA_HEADERS={}
VLM_EXTRA_BODY={}
# Optional examples:
# VLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ---- automatic multi-stream completion ----
VLM_MAX_FRAMES_PER_REQUEST=8
VLM_FRAMES_PER_STREAM=1
VLM_CONFIRMATION_VOTES=2
VLM_MIN_CONFIDENCE=0.6
VLM_SETTLE_SECONDS=1

# Kept for optional local-Qwen legacy paths in this folder; not used by scene-worker API mode.
HF_HOME=/home/sceneworker/.cache/huggingface

# Local project-video test. Runtime settings, not Docker build arguments.
SCENE_TEST_BACKEND_URL=http://host.docker.internal:8080/api/authoringv2
SCENE_TEST_PROJECT_ID=6afd4d745b97303aa9215b7f
SCENE_TEST_ORGANIZATION_ID=6afd4d672b7827ebb469a41c
# Your current login JWT with CAN_VIEW_ASSETS permission, without "Bearer ".
SCENE_TEST_BACKEND_TOKEN=
SCENE_TEST_TIMEOUT=600
# Only raise for a verified local mirror/clock skew; signature checks stay on.
APT_MAX_FUTURE_TIME=10
